PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/inside_odc
JWT_SECRET=change_me
JWT_COOKIE_SAMESITE=lax
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
APP_BASE_URL=http://localhost:5173
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
AI_ENABLED=true
AI_RATE_LIMIT_MAX=30
ANTHROPIC_API_KEY=change_me
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=1024

# Global API throttling
RATE_LIMIT_MAX=300

# Sensitive auth endpoints throttling (/auth/*)
AUTH_RATE_LIMIT_MAX=40

# Express JSON body size limit
JSON_BODY_LIMIT=1mb

# Service d'envoi : « brevo » ou « smtp ». A defaut, Brevo prime s'il est
# configure. Sans ce reglage, SMTP l'emportait silencieusement des qu'il etait
# renseigne, meme avec une cle Brevo en place.
MAIL_PROVIDER=brevo

# ATTENTION : le domaine de MAIL_FROM doit etre celui que le service d'envoi
# est autorise a utiliser. Envoyer par un compte @orange-sonatel.com en se
# presentant comme @orangedigitalcenter.sn empeche SPF et DKIM de s'aligner :
# Gmail, Yahoo et Outlook rejettent le message depuis fevrier 2024.
MAIL_FROM=contact@orangedigitalcenter.sn
MAIL_FROM_NAME=Inside ODC

# Adresse de reponse, facultative. L'adresse d'expedition est contrainte par le
# domaine qui authentifie l'envoi ; l'adresse de reponse ne l'est pas. Permet
# d'envoyer depuis une boite institutionnelle et de recevoir les reponses
# ailleurs. Voir docs/expediteur-orange-sonatel.md
# MAIL_REPLY_TO=prenom.nom@orange-sonatel.com

# Cadence d'envoi des campagnes. Exchange Online coupe au-dela d'une trentaine
# de messages par minute ; on reste en dessous pour laisser passer les emails
# transactionnels qui partent en meme temps.
MAIL_DEBIT_PAR_MINUTE=25

# Adresse publique de l'API, utilisee dans les liens de desabonnement. A
# defaut, elle est deduite de la requete qui lance l'envoi.
# API_BASE_URL=https://inside-odc-api.up.railway.app
BREVO_API_KEY=change_me
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=orangedigitalcenter@orange-sonatel.com
SMTP_PASS=change_me
SMTP_SECURE=false

# Use one of these two options for admin PIN validation:
# 1) Plain value (legacy/simple)
ADMIN_PIN=2468
# 2) Preferred hashed value (bcrypt)
# ADMIN_PIN_HASH=$2b$10$replace_with_bcrypt_hash

# In production:
# - set NODE_ENV=production
# - set CORS_ORIGIN to your frontend domain(s)
# - prefer ADMIN_PIN_HASH and remove ADMIN_PIN
# - set DB_SSL=true (required by hosted Postgres providers like Neon)
# - if frontend and backend are on different domains, set JWT_COOKIE_SAMESITE=none
